


:root {
  --bg-main: #121212;
  --bg-card: #1a1a1a;
  --text-main: #ffffff;
  --text-muted: #a0a0a0;
  --accent: #ff8c00;
  --glass-border: 1px solid rgba(255, 255, 255, 0.05);
  --glass-bg: rgba(26, 26, 26, 0.7);
  --white: #ffffff;
  --raisin-black: #121212;
  --white_a10: rgba(255,255,255,0.7);
}

body {
  font-family: "Poppins", sans-serif;
  background: var(--bg-main);
  color: var(--text-main);
  scroll-behavior: smooth;
}

/* Fade-in Animation Classes */




html {
  scroll-behavior: smooth;
}

p {
  color: var(--text-main);
}

/* TRANSITION */

a,
.btn {
  transition: all 300ms ease;
}

/* DESKTOP NAV */

nav,
.nav-links {
  display: flex;
}

nav {
  justify-content: space-between;
  align-items: center;
  height: 80px;
  position: sticky;
  top: 0;
  z-index: 1000;
  padding: 0 5%;
  background: rgba(18, 18, 18, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: var(--glass-border);
}

.nav-links {
  gap: 2rem;
  list-style: none;
  font-size: 1rem;
}

a {
  color: var(--text-muted);
  text-decoration: none;
}

a:hover {
  color: var(--text-main);
}

.logo {
  font-size: 2rem;
  color: var(--accent);
  font-weight: bold;
}

.logo:hover {
  cursor: default;
}

/* PHONE */

.p-logo{
  font-size: 0.5 rem;
  color: var(--white);
}


.p-logo:hover {
  cursor: default;
}

.navi-links {
  display: flex;
  font-size: 0.9rem;
  gap: 1rem;
  list-style-type: none;
}

/* TAB */

.t-logo{
    font-size: 1.5rem;

  color: var(--white);
}


.t-logo:hover {
  cursor: default;
}

.nave-links {
  display: flex;
}

.nave-links {
  gap: 1rem;
  list-style: none;
  font-size: 1.8 rem;
}


/* SECTIONS */

section {
  padding-top: 4vh;
  height: 96vh;
  margin: 0 10rem;
  box-sizing: border-box;
  min-height: fit-content;
}

.section-container {
  display: flex;
}

/* PROFILE SECTION */

#profile {
  display: flex;
  justify-content: center;
  gap: 5rem;
  height: 80vh;
}

.section__pic-container-2 {
  display: flex;
  height: auto;
  width: 100%;
  max-width: 300px;
  max-height: 300px;
  margin-top: 1rem;
  border-radius: 30px;
  margin-left: 0.3rem;
  overflow: hidden;
}

.section__pic-container-2 img {
  width: 100%;
  height: auto;
  border-radius: 30px;
  object-fit: cover;
}

.section__pic-container {
  display: flex;
  height: 400px;
  width: 400px;
  margin: auto 0;
  border-radius: 50%;
  overflow: hidden;
  border: 5px solid var(--bg-card); /* Add a slight border for elegance */
}
.section__pic-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.section__text {
  align-self: center;
  text-align: center;
}

.section__text p {
  font-weight: 600;
}

.section__text__p0 {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 20px;
  }

.section__text__p1 {
  text-align: center;
  margin-bottom: 1rem;
}

.section__text__p4 {
    text-align: center;
    margin-bottom: 1rem;
    color: var(--raisin-black);
  }

  .section__text__p5 {
    text-align: center;
    margin-bottom: 1rem;
    color: var(--raisin-black);
  }

  .section__text__p6 {
    text-align: center;
    margin-top: 1.5rem;
    color: var(--white);
  }

.section__text__p2 {
  font-size: 1.5rem;
  margin-bottom: 3rem;
  color: var(--white_a10);
  white-space: pre-line;
}



.title {
  font-size: 3rem;
  text-align: left;
  color: var(--text-main);
  margin-bottom: 2rem;
}


.title2 {
  font-size: 3rem;
  text-align: left;
  color: var(--text-main);
}

.title-accent {
  font-size: 3.5rem;
  font-weight: 700;
  text-align: left;
  color: var(--accent);
  margin-bottom: 1rem;
  line-height: 1.2;
}


.title3 {
    font-size: 3rem;
    margin-bottom: 2rem;
    text-align: center;
    color: var(--raisin-black);
  }

.title4{
  font-size: 3rem;
  text-align: center;
  color: var(--white);
  margin-bottom: 0.5rem;
}

#socials-container {
  display: flex;
  justify-content: center;
  margin-top: 1rem;
  gap: 1rem;
}

/* ICONS */

.icon {
  cursor: pointer;
  height: 2rem;
}

/* BUTTONS */

.btn-container {
  display: flex;
  justify-content: flex-start;
  gap: 1rem;
}

.btn {
  font-weight: 500;
  transition: all 300ms ease;
  padding: 0.8rem 1.8rem;
  width: auto;
  border-radius: 14px;
  cursor: pointer;
  font-family: "Poppins", sans-serif;
  font-size: 1rem;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border: none;
  box-shadow: 0 4px 15px rgba(10, 132, 255, 0.3);
}

.btn-primary:hover {
  background: #007aff;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(10, 132, 255, 0.4);
}

.btn-outline {
  background: rgba(255, 255, 255, 0.05);
  color: var(--text-main);
  border: var(--glass-border);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.btn-outline:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-2px);
}

/* ABOUT SECTION */

.about-containers {
  gap: 2rem;
  margin-bottom: 1rem;
}

.about-details-container {
  justify-content: center;
  flex-direction: column;
  text-align: left;
  margin-top: 1rem;
}


.about-containers,
.about-details-container {
  display: flex;
}

.about-pic {
  border-radius: 2rem;
}

.arrow {
  position: absolute;
  right: -5rem;
  bottom: 2.5rem;
}

.details-container {
  padding: 1.5rem;
  flex: 1;
  background: black;
  border-radius: 2rem;
  border: rgb(53, 53, 53) 0.3rem solid;
  border-color: rgb(163, 163, 163);
  text-align: center;
  color: var(--white);
}

.heading3 {
  margin-top: 0.8rem;
  margin-bottom: 1rem;
}
.text-container{
    justify-content: space-between;
    text-align: center;
    color:black;
}

p a.certlink{
    color: var(--white);
    text-decoration: none;
    text-decoration-color: black;
}

p a.certlink:hover {
  color: grey;
  font-weight: bold;
}

.section-container {
  gap: 2rem;
  height: 80%;
  display: flex;
  justify-content: center;
  align-items: center;
}


/* SLIDER SECTION */

#photo_slider{
  margin-top: 4rem;
  margin-bottom: 1rem;
}

.wrapper {
  width: 100%;
  height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* PORTFOLIO CARD */
.portfolio-card {
  transition: all 0.3s ease;
  border-radius: 20px;
  background: var(--bg-card);
  border: var(--glass-border);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
}

.portfolio-card:hover {
  transform: translateY(-5px);
  background: rgba(255, 255, 255, 0.08);
}

.container {
  height: 500px;
  max-width: 100rem;
  display: flex;
  flex-wrap: nowrap;
  justify-content: start;
}

.card {
  width: 80px;
  border-radius: .75rem;
  background-size: cover;
  cursor: pointer;
  overflow: hidden;
  border-radius: 2rem;
  margin: 0 10px;
  display: flex;
  align-items: flex-end;
  transition: .6s cubic-bezier(.28,-0.03,0,.99);
  box-shadow: 0px 10px 30px -5px rgba(0,0,0,0.8);
}

.card > .row {
  color: white;
  display: flex;
  flex-wrap: nowrap;
}

.card > .row > .icon {
  background: #223;
  color: white;
  border-radius: 50%;
  width: 50px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15px;
}

.card > .row > .description {
  display: flex;
  justify-content: center;
  flex-direction: column;
  overflow: hidden;
  height: 80px;
  width: 520px;
  opacity: 0;
  transform: translateY(30px);
  transition-delay: .3s;
  transition: all .3s ease;
}

.description p {
  color: var(--text-main);
}

.description h4 {
  text-transform: uppercase;
}

input {
  display: none;
}

input:checked + label {
  width: 600px;
}

input:checked + label .description {
  opacity: 1 !important;
  transform: translateY(0) !important;
}

.card[for="c1"] {
  background-image: url('./images/458269708_2496947483825901_3249515695000074931.jpg');
}
.card[for="c2"] {
  background-image: url('./images/459651636_513074027977262_4576838433371601191_n.jpg');
}
.card[for="c3"] {
  background-image: url('./images/457851549_402019309594471_7210508733290643232_n.jpg');
}
.card[for="c4"] {
  background-image: url('./images/IMG_2764.JPG');
}


/* BANNERS */

#artworks{
  margin-top: 6rem;
  margin-bottom: 7rem;
}

.insdes{
  margin-top: 1rem;
}

.heading4{
  font-weight: bold;
  font-size: 25px;
}

.banners{
    width: 100%;
    height: 90vh;
    text-align: center;
    position: relative;
}
.banners .sliders{
    position: absolute;
    width: 170px;
    height: 200px;
    top: 10%;
    left: calc(50% - 85px);
    transform-style: preserve-3d;
    transform: perspective(800px);
    animation: autoRun 20s linear infinite;
    z-index: 2;
}
@keyframes autoRun{
    from{
        transform: perspective(800px) rotateX(-16deg) rotateY(0deg);
    }to{
        transform: perspective(800px) rotateX(-16deg) rotateY(360deg);
    }
}

.banners .sliders .items{
    position: absolute;
    inset: 0 0 0 0;
    transform:
        rotateY(calc( (var(--position) - 1) * (360 / var(--quantity)) * 1deg))
        translateZ(400px);
}
.banners .sliders .items img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: solid 2px var(--white);
}
.banners .contents{
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, 100vw);
    height: max-content;
    padding-bottom: 80px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    z-index: 1;
}
.banners .contents h1{
    font-family: 'ICA Rubrik';
    font-size: 12em;
    line-height: 1em;
    color: var(--white);
    position: relative;
}
.banners .contents h1::after{
    position: absolute;
    inset: 0 0 0 0;
    content: attr(data-content);
    z-index: 2;
    -webkit-text-stroke: 1.5px #d2d2d2;
    color: transparent;
}
.banners .contents .authors{
    text-align: right;
    max-width: 180px;
}
.banners .contents h2{
    font-size: 2.5em;
}
.banners .contents .model{
    width: 100%;
    height: 65vh;
    position: absolute;
    bottom: 0;
    left: 0;
    background-size: auto 120%;
    background-repeat: no-repeat;
    background-position: top center;
    z-index: 1;
}



/* EXPERIENCE SECTION */

#experience {
  position: relative;
  margin-top: 2rem;
  margin-bottom: 0;
}

.experience-sub-title {
  color: rgb(116, 116, 116);
  font-weight: 600;
  font-size: 1.75rem;

}

.experience-details-container {
  display: flex;
  justify-content: center;
  flex-direction: column;
}



.article-container {
  display: flex;
  text-align: initial;
  flex-wrap: wrap;
  flex-direction: row;
  gap: 1rem;
  justify-content: space-between;
  align-items: center;
}

article {
  display: flex;
  width: 10rem;
  justify-content: space-between;
  gap: 0.2rem;
  margin: 0;
  padding: 0;
}

article .icon {
  cursor: default;
}


/* PROJECTS SECTION */

#projects {
  position: relative;
  background-color: transparent;
  padding: 3rem;
  border-top-right-radius: 5rem;
  border-bottom-left-radius: 5rem;
  margin-top: 2rem;
}

.color-container {
  border-color: rgb(163, 163, 163);
  background: rgb(0, 0, 0);
}

.project-img {
  border-radius: 2rem;
  width: 100%;
  height: 100%;
}

.project-title {
  margin: 1rem;
  color: var(--white);
}

.co-author{
  font-size: 0.9rem;
  text-align: center;
  font-weight: bold;
  margin: 1rem;
  gap: 1rem;
  color: var(--white_a10);
}

.project-btn {
  color: var(--white);
  border-color: rgb(163, 163, 163);
}

/* CONTACT */

#contact {
  display: flex;
  justify-content: center;
  flex-direction: column;
  height: 70vh;
  margin-top: 20vh;
}

.contact-info-upper-container {
  display: flex;
  justify-content: center;
  border-radius: 2rem;
  border: rgb(53, 53, 53) 0.1rem solid;
  border-color: rgb(163, 163, 163);
  background: (250, 250, 250);
  margin: 2rem auto;
  padding: 0.5rem;
}

.contact-info-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  margin: 1rem;
}

.contact-info-container p {
  font-size: larger;
}

.contact-icon {
  cursor: default;
}

.email-icon {
  height: 2.5rem;
}

/* FOOTER SECTION */

footer {
  height: 26vh;
  margin: 0 1rem;
}

footer p {
  text-align: center;
}








/* SERVICES */
.services-container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin: 0 auto;
}

.service-card {
  background: var(--bg-card);
  padding: 2rem;
  border-radius: 20px;
  text-align: center;
  transition: all 0.3s ease;
  border: var(--glass-border);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
}

.service-card:hover {
  transform: translateY(-5px);
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}


/* Skill Circle */
.skill-circle {
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: conic-gradient(var(--color) calc(var(--percent) * 1%), rgba(255,255,255,0.1) 0);
  display: flex;
  align-items: center;
  justify-content: center;
}

.skill-circle .inner-circle {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--bg-main);
  display: flex;
  align-items: center;
  justify-content: center;
}
@keyframes spin {
  100% {
    transform: rotate(360deg);
  }
}
